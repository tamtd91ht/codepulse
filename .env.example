# Copy to .env and fill in. See docs/specs/13_DEPLOYMENT_OPS.md.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://codepulse:change-me@postgres:5432/codepulse
REDIS_URL=redis://redis:6379/0
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
APP_BASE_URL=https://codepulse.company.vn

LLM_PROVIDER=claude_code      # claude_code|anthropic|openai|ollama
# Empty = claude-opus-5-5. Admin › Cài đặt review can pick another model without a restart.
LLM_MODEL=
# claude_code with a Claude subscription: token from `claude setup-token` (sk-ant-oat…).
# Or leave it empty and use Admin › Đăng nhập Claude: a token set there wins over these two.
CLAUDE_CODE_OAUTH_TOKEN=
# Or an Anthropic API key (used only when CLAUDE_CODE_OAUTH_TOKEN is empty)
LLM_API_KEY=
CLAUDE_CODE_BIN=claude
MONTHLY_LLM_BUDGET_USD=200
# Close critical/high findings a later change fixed: off by default; when on, each review checks
# the repo's open ones of the last AUTO_CLOSE_DAYS days (required). Also on Admin > Cài đặt review.
AUTO_CLOSE_FINDINGS=false
AUTO_CLOSE_DAYS=0
MAX_REVIEW_LOC=1500
# .claude files quoted to the model (per file, first pass total, deep pass total); also on
# Admin › Cài đặt review.
# CLAUDE_FILE_CHARS=60000
# FAST_GUIDANCE_CHARS=120000
# DEEP_INSTRUCTIONS_CHARS=300000
MAX_TOKENS_PER_CHUNK=12000
MIN_CONFIDENCE=0.4
# SCORING_WEIGHTS={"critical": 25, "high": 10, "medium": 4, "low": 1, "info": 0}
MIN_SAMPLE=3

BACKFILL_DAYS=90
SYNC_INTERVAL_MIN=30
IGNORE_PATHS=*.lock,dist/**,vendor/**,*.min.js,**/generated/**
SENSITIVE_PATHS=**/secrets/**,.env*,*.pem,*.key
ALLOWED_EMAIL_DOMAINS=company.vn

REPORT_TZ=Asia/Ho_Chi_Minh

# Dashboard sign-in with GitLab (Admin > Applications, scopes: openid email profile read_user,
# redirect URI: <APP_BASE_URL>/api/v1/auth/callback)
# The dashboard serves the API under /api, so APP_BASE_URL and DASHBOARD_URL are usually the same.
DASHBOARD_URL=https://codepulse.company.vn
# Links sent out (Telegram, webhooks, report e-mails) use DASHBOARD_URL unless Admin ›
# Cài đặt review sets another address (e.g. a domain in front of ip:port).
# Sign-in also works on that address or on DASHBOARD_URL when their host differs from
# APP_BASE_URL's: add <that address>/api/v1/auth/callback as another redirect URI of the GitLab
# application (scheme + host[:port] only, no path).
GITLAB_OAUTH_URL=https://gitlab.company.vn
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_TTL_HOURS=12
ADMIN_EMAILS=admin@company.vn
# Optional: only accept webhooks from GitLab's addresses (comma-separated IPs or CIDRs).
WEBHOOK_ALLOWED_IPS=
# Prometheus scrape token for /metrics (empty = no auth; only on an internal network).
METRICS_TOKEN=
SMTP_URL=smtps://codepulse:password@smtp.company.vn:465
SMTP_FROM=codepulse@company.vn
SLACK_WEBHOOK_URL=
# REPORT_CHANNELS={"Backend": {"slack": "https://hooks.slack.com/...", "emails": ["backend@company.vn"]}}
RETENTION_DAYS=365

# Telegram review bots are configured in Admin > Telegram (tokens live in the DB, encrypted).
TELEGRAM_POLL_INTERVAL_S=5
TELEGRAM_COMMANDS_PER_10MIN=20
TELEGRAM_MAX_TARGETS=20
# Yêu cầu review trên dashboard: số commit liệt kê tối đa và số commit review mỗi lần
REVIEW_COMMITS_LIST_MAX=200
REVIEW_BATCH_MAX=50
# Review sâu (spec 18): đối chứng trong bản sao repo với Read/Grep/Glob
# Luong review v2 (docs/specs/19 §4, §8). Ten cu DEEP_REVIEW* van duoc nhan.
REVIEW_AGENT=true
REVIEW_AGENT_MIN_LOC=20
REVIEW_MAX_TURNS=40
REVIEW_TIMEOUT_S=480
REVIEW_CHUNK_TOKENS=60000
DEEP_REVIEW_MAX_ARCHIVE_MB=300
VERIFY=true
VERIFY_MAX_FINDINGS=12
VERIFY_MAX_TURNS=15
VERIFY_MIN_CONFIDENCE_UNVERIFIED=0.7
# Tri thuc review (docs/specs/19 §3)
KNOWLEDGE_MAX_TURNS=40
KNOWLEDGE_TIMEOUT_S=300
KNOWLEDGE_MAX_COST_USD=5
KNOWLEDGE_TOKENS=12000
PROFILE_TTL_DAYS=7
# Chay command .claude tu dashboard (Admin > Chay command, app/commands); sua duoc tren Admin
# Tat han tinh nang (an tab, API 404, run dang cho bi huy): COMMAND_RUNS_ENABLED=false
# COMMAND_RUNS_DIR=/tmp/codepulse-runs
# COMMAND_SANDBOX=docker  # local chi o may dev: worker tu chay claude
# COMMAND_GATE_SOCKET=/run/codepulse-gate/gate.sock
# COMMAND_DISK_MB=5120
# Gioi han cua container (service command-gate doc): COMMAND_MEMORY_MB=4096, COMMAND_CPUS=2
COMMAND_TIMEOUT_MIN=30
COMMAND_MAX_TURNS=100
COMMAND_MAX_BUDGET_USD=5
COMMAND_CLONE_DEPTH=50
COMMAND_MAX_OUTPUT_MB=200
COMMAND_FILE_TTL_HOURS=24
# TELEGRAM_API_BASE=https://api.telegram.org
