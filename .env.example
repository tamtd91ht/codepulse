# Copy to .env and fill in. See docs/specs/13_DEPLOYMENT_OPS.md.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://codepulse:change-me@postgres:5432/codepulse
REDIS_URL=redis://redis:6379/0
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
APP_BASE_URL=https://codepulse.company.vn

LLM_PROVIDER=claude_code      # claude_code|anthropic|openai|ollama
LLM_MODEL=
# claude_code with a Claude subscription: token from `claude setup-token` (sk-ant-oat…)
CLAUDE_CODE_OAUTH_TOKEN=
# Or an Anthropic API key (used only when CLAUDE_CODE_OAUTH_TOKEN is empty)
LLM_API_KEY=
CLAUDE_CODE_BIN=claude
MONTHLY_LLM_BUDGET_USD=200
MAX_REVIEW_LOC=1500
MAX_TOKENS_PER_CHUNK=12000
MIN_CONFIDENCE=0.5
# SCORING_WEIGHTS={"critical": 25, "high": 10, "medium": 4, "low": 1, "info": 0}
MIN_SAMPLE=3

BACKFILL_DAYS=90
SYNC_INTERVAL_MIN=30
IGNORE_PATHS=*.lock,dist/**,vendor/**,*.min.js,**/generated/**
SENSITIVE_PATHS=**/secrets/**,.env*,*.pem,*.key
ALLOWED_EMAIL_DOMAINS=company.vn

REPORT_TZ=Asia/Ho_Chi_Minh

# Dashboard sign-in with GitLab (Admin > Applications, scopes: openid email profile read_user,
# redirect URI: <APP_BASE_URL>/api/v1/auth/callback)
# The dashboard serves the API under /api, so APP_BASE_URL and DASHBOARD_URL are usually the same.
DASHBOARD_URL=https://codepulse.company.vn
GITLAB_OAUTH_URL=https://gitlab.company.vn
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_TTL_HOURS=12
ADMIN_EMAILS=admin@company.vn
# Optional: only accept webhooks from GitLab's addresses (comma-separated IPs or CIDRs).
WEBHOOK_ALLOWED_IPS=
# Prometheus scrape token for /metrics (empty = no auth; only on an internal network).
METRICS_TOKEN=
SMTP_URL=smtps://codepulse:password@smtp.company.vn:465
SMTP_FROM=codepulse@company.vn
SLACK_WEBHOOK_URL=
# REPORT_CHANNELS={"Backend": {"slack": "https://hooks.slack.com/...", "emails": ["backend@company.vn"]}}
RETENTION_DAYS=365

# Telegram review bots are configured in Admin > Telegram (tokens live in the DB, encrypted).
TELEGRAM_POLL_INTERVAL_S=5
TELEGRAM_COMMANDS_PER_10MIN=20
TELEGRAM_MAX_TARGETS=20
# Yêu cầu review trên dashboard: số commit liệt kê tối đa và số commit review mỗi lần
REVIEW_COMMITS_LIST_MAX=200
REVIEW_BATCH_MAX=50
# Review sâu (spec 18): đối chứng trong bản sao repo với Read/Grep/Glob
DEEP_REVIEW=true
DEEP_REVIEW_MAX_TURNS=40
DEEP_REVIEW_TIMEOUT_S=600
DEEP_REVIEW_MAX_ARCHIVE_MB=300
DEEP_REVIEW_MIN_LOC=0
PROFILE_TTL_DAYS=7
# TELEGRAM_API_BASE=https://api.telegram.org
