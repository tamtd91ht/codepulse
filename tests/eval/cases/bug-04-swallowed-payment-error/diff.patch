@@ -0,0 +1,13 @@
+import logging
+
+from app.billing.gateway import charge
+
+log = logging.getLogger(__name__)
+
+
+def checkout(cart_id: int, amount: int, card_token: str) -> dict:
+    try:
+        receipt = charge(card_token, amount)
+    except Exception:
+        receipt = None
+    return {"cart_id": cart_id, "status": "paid", "receipt": receipt}
