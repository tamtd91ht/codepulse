@@ -0,0 +1,16 @@
+import pytest
+
+from app.text import slugify
+
+
+@pytest.mark.parametrize(
+    ("title", "slug"),
+    [
+        ("Hello World", "hello-world"),
+        ("  Trim me  ", "trim-me"),
+        ("Tiếng Việt có dấu", "tieng-viet-co-dau"),
+        ("a--b", "a-b"),
+    ],
+)
+def test_slugify(title: str, slug: str) -> None:
+    assert slugify(title) == slug
