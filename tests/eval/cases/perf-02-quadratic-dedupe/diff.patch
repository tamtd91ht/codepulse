+def unique_emails(rows: list[dict]) -> list[str]:
+    """Called on CSV imports with up to 200k rows."""
+    seen: list[str] = []
+    for row in rows:
+        email = row["email"].strip().lower()
+        if email not in seen:
+            seen.append(email)
+    return seen
