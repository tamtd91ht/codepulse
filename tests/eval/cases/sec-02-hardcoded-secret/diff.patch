+import httpx
+
+STRIPE_SECRET_KEY = "prod-pay-9f8e7d6c5b4a3210fedcba9876543210"
+API_BASE = "https://api.stripe.com/v1"
+
+
+def create_charge(amount_cents: int, customer_id: str) -> dict:
+    response = httpx.post(
+        f"{API_BASE}/charges",
+        data={"amount": amount_cents, "currency": "usd", "customer": customer_id},
+        auth=(STRIPE_SECRET_KEY, ""),
+        timeout=10,
+    )
+    response.raise_for_status()
+    return response.json()
