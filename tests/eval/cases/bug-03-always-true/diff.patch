+from app.orders.models import Order
+from app.shipping import create_shipment
+
+
+def ship_if_ready(order: Order) -> bool:
+    if order.status == "paid" or "confirmed":
+        create_shipment(order)
+        order.status = "shipped"
+        return True
+    return False
